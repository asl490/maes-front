{
  "$schema": "node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.23.0",
    "generators": {
      "maes-angular": {
        "generatorName": "typescript-angular",
        "inputSpec": "http://localhost:8080/api/v1/v3/api-docs",
        "output": "#{cwd}/src/app/core/api/generated",
        "additionalProperties": {
          "ngVersion": "21.2.0",
          "rxjsVersion": "7.8.0",
          "providedIn": "root",
          "stringEnums": true,
          "modelPropertyNaming": "camelCase",
          "withInterfaces": true
        }
      }
    }
  }
}
